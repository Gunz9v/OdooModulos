<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sire_sunat_proposal_import_wizard_form" model="ir.ui.view">
        <field name="name">sire.sunat.proposal.import.wizard.form</field>
        <field name="model">sire.sunat.proposal.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="period_id" readonly="1"/>
                    <field name="filename" invisible="1"/>
                    <field name="file_data" filename="filename"/>
                </group>
                <footer>
                    <button name="action_import_file" type="object" string="Importar propuesta" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
