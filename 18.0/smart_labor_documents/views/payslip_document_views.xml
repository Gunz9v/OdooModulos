<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payslip_document_list" model="ir.ui.view">
        <field name="name">employee.payslip.document.list</field>
        <field name="model">employee.payslip.document</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="period"/>
                <field name="template_id"/>
                <field name="batch_id"/>
                <field name="is_read"/>
                <field name="read_date"/>
                <field name="signature_required"/>
                <field name="signature_state"/>
                <field name="digital_signer_user_id"/>
                <field name="signed_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_payslip_document_form" model="ir.ui.view">
        <field name="name">employee.payslip.document.form</field>
        <field name="model">employee.payslip.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="Publicar" class="btn-primary" invisible="state == 'published'"/>
                    <button name="action_set_draft" type="object" string="Pasar a Borrador" invisible="state == 'draft'"/>
                    <button name="action_sync_legajo_document" type="object" string="Enviar a Legajo"/>
                    <button name="action_reset_signature" type="object" string="Reiniciar acuse" invisible="signature_state != 'signed'"/>
                    <button name="%(action_report_payslip_document)d" type="action" string="Imprimir PDF"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="period"/>
                            <field name="template_id"/>
                        </group>
                        <group>
                            <field name="batch_id"/>
                            <field name="employee_user_id" readonly="1"/>
                            <field name="is_read"/>
                            <field name="read_date"/>
                            <field name="signature_required"/>
                            <field name="signature_state" readonly="1"/>
                            <field name="digital_signer_user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documento">
                            <field name="signed_document_preview_html" widget="html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Acuse de recepcion">
                            <field name="signature_preview_html" widget="html" readonly="1" nolabel="1"/>
                            <group>
                                <group>
                                    <field name="signature_state" readonly="1"/>
                                    <field name="signature_name" readonly="1"/>
                                    <field name="signed_date" readonly="1"/>
                                    <field name="signed_by_id" readonly="1"/>
                                    <field name="signed_partner_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="signature_ip" readonly="1"/>
                                    <field name="signature_user_agent" readonly="1"/>
                                    <field name="signature_position_x" readonly="1"/>
                                    <field name="signature_position_y" readonly="1"/>
                                    <field name="signature_image" readonly="1" invisible="1"/>
                                    <field name="signature_hash" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Documento Original">
                            <field name="rendered_html" widget="html"/>
                        </page>
                        <page string="Valores Importados">
                            <field name="values_json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_payslip_documents" model="ir.actions.act_window">
        <field name="name">Boletas Generadas</field>
        <field name="res_model">employee.payslip.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
