<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sire" model="ir.module.category">
        <field name="name">SIRE</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_sire_user" model="res.groups">
        <field name="name">Usuario SIRE</field>
        <field name="category_id" ref="module_category_sire"/>
    </record>

    <record id="group_sire_analyst" model="res.groups">
        <field name="name">Analista SIRE</field>
        <field name="category_id" ref="module_category_sire"/>
        <field name="implied_ids" eval="[(4, ref('group_sire_user'))]"/>
    </record>

    <record id="group_sire_tax_responsible" model="res.groups">
        <field name="name">Responsable tributario SIRE</field>
        <field name="category_id" ref="module_category_sire"/>
        <field name="implied_ids" eval="[(4, ref('group_sire_analyst'))]"/>
    </record>

    <record id="group_sire_manager" model="res.groups">
        <field name="name">Administrador SIRE</field>
        <field name="category_id" ref="module_category_sire"/>
        <field name="implied_ids" eval="[(4, ref('group_sire_tax_responsible'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
