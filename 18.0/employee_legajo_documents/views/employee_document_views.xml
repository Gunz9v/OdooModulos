<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_document_type_list" model="ir.ui.view">
        <field name="name">employee.document.type.list</field>
        <field name="model">employee.document.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="required"/>
                <field name="signature_required"/>
                <field name="allow_history"/>
                <field name="legajo_document_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_employee_document_type_form" model="ir.ui.view">
        <field name="name">employee.document.type.form</field>
        <field name="model">employee.document.type</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prepare_active_employee_legajos" type="object" string="Preparar empleados activos" class="btn-primary"/>
                    <button name="action_view_legajo_documents" type="object" string="Ver legajos"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_legajo_documents"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-folder-open">
                            <field name="legajo_document_count" widget="statinfo" string="Legajos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="category"/>
                        <field name="required"/>
                        <field name="signature_required"/>
                        <field name="allow_history"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_employee_document_file_list" model="ir.ui.view">
        <field name="name">employee.document.file.list</field>
        <field name="model">employee.document.file</field>
        <field name="arch" type="xml">
            <list decoration-danger="state in ['pending', 'expired', 'rejected']" decoration-success="state == 'validated'">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="document_type_id"/>
                <field name="category"/>
                <field name="document_date"/>
                <field name="expiration_date"/>
                <field name="file_name"/>
                <field name="worker_signature_state"/>
                <field name="signature_state"/>
                <field name="history_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_employee_document_file_form" model="ir.ui.view">
        <field name="name">employee.document.file.form</field>
        <field name="model">employee.document.file</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object" string="Validar" class="btn-primary" invisible="state == 'validated'"/>
                    <button name="action_reject" type="object" string="Rechazar" invisible="state == 'rejected'"/>
                    <button name="action_set_pending" type="object" string="Marcar Pendiente" invisible="state == 'pending'"/>
                    <button name="action_open_digital_signature_wizard" type="object" string="Firmar PDF con certificado" class="btn-primary" invisible="not signature_required or signature_state == 'signed' or not file_data"/>
                    <button name="action_reset_signature" type="object" string="Reiniciar firma encargado" invisible="signature_state != 'signed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,uploaded,validated,rejected,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="document_type_id"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="document_date"/>
                            <field name="expiration_date"/>
                            <field name="uploaded_by_id"/>
                            <field name="upload_date"/>
                            <field name="latest_upload_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group string="Firma del trabajador">
                        <group>
                            <field name="worker_signature_required"/>
                            <field name="worker_signature_state" readonly="1"/>
                            <field name="worker_signed_date" readonly="1"/>
                            <field name="worker_signed_by_id" readonly="1"/>
                            <field name="worker_signed_partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="worker_signature_name" readonly="1"/>
                            <field name="worker_signature_hash" readonly="1"/>
                        </group>
                    </group>
                    <group string="Firma certificada del encargado">
                        <group>
                            <field name="signature_required"/>
                            <field name="signature_state" readonly="1"/>
                            <field name="signed_date" readonly="1"/>
                            <field name="signed_by_id" readonly="1"/>
                            <field name="signed_partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="signature_name" readonly="1"/>
                            <field name="signature_attachment_name" readonly="1"/>
                            <field name="signature_hash" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes" nolabel="1"/>
                        </page>
                        <page string="Historico">
                            <field name="history_ids" context="{'default_legajo_id': id}">
                                <list editable="bottom" decoration-success="state == 'validated'" decoration-danger="state == 'rejected'">
                                    <field name="name"/>
                                    <field name="period"/>
                                    <field name="document_date"/>
                                    <field name="file_data" filename="file_name"/>
                                    <field name="file_name" invisible="1"/>
                                    <field name="worker_signature_state"/>
                                    <field name="signature_state"/>
                                    <field name="signed_date"/>
                                    <field name="signature_attachment_name"/>
                                    <field name="upload_date" readonly="1"/>
                                    <field name="uploaded_by_id" readonly="1"/>
                                    <field name="state"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Origen">
                            <group>
                                <field name="source_model" readonly="1"/>
                                <field name="source_res_id" readonly="1"/>
                            </group>
                        </page>
                        <page string="Evidencia de firma trabajador" invisible="worker_signature_state != 'signed'">
                            <group>
                                <group>
                                    <field name="worker_signature_required" readonly="1"/>
                                    <field name="worker_signature_state" readonly="1"/>
                                    <field name="worker_signed_date" readonly="1"/>
                                    <field name="worker_signed_by_id" readonly="1"/>
                                    <field name="worker_signed_partner_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="worker_signature_name" readonly="1"/>
                                    <field name="worker_signature_hash" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Evidencia firma encargado" invisible="signature_state != 'signed'">
                            <group>
                                <field name="signature_certificate_subject" readonly="1"/>
                                <field name="signature_certificate_issuer" readonly="1"/>
                                <field name="signature_hash" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_employee_document_history_list" model="ir.ui.view">
        <field name="name">employee.document.history.list</field>
        <field name="model">employee.document.history</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'validated'" decoration-danger="state == 'rejected'">
                <field name="employee_id"/>
                <field name="document_type_id"/>
                <field name="period"/>
                <field name="document_date"/>
                <field name="file_name"/>
                <field name="worker_signature_state"/>
                <field name="signature_state"/>
                <field name="signed_date"/>
                <field name="upload_date"/>
                <field name="uploaded_by_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_employee_document_history_form" model="ir.ui.view">
        <field name="name">employee.document.history.form</field>
        <field name="model">employee.document.history</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object" string="Validar" class="btn-primary" invisible="state == 'validated'"/>
                    <button name="action_reject" type="object" string="Rechazar" invisible="state == 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="uploaded,validated,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="legajo_id"/>
                            <field name="employee_id"/>
                            <field name="document_type_id"/>
                            <field name="period"/>
                        </group>
                        <group>
                            <field name="document_date"/>
                            <field name="expiration_date"/>
                            <field name="upload_date"/>
                            <field name="uploaded_by_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes" nolabel="1"/>
                        </page>
                        <page string="Evidencia de firma trabajador" invisible="worker_signature_state != 'signed'">
                            <group>
                                <group>
                                    <field name="worker_signature_required"/>
                                    <field name="worker_signature_state"/>
                                    <field name="worker_signed_date"/>
                                    <field name="worker_signed_by_id"/>
                                    <field name="worker_signed_partner_id"/>
                                </group>
                                <group>
                                    <field name="worker_signature_name"/>
                                    <field name="worker_signature_hash"/>
                                </group>
                            </group>
                        </page>
                        <page string="Evidencia firma encargado" invisible="signature_state != 'signed'">
                            <group>
                                <group>
                                    <field name="signature_required"/>
                                    <field name="signature_state"/>
                                    <field name="signed_date"/>
                                    <field name="signed_by_id"/>
                                    <field name="signed_partner_id"/>
                                </group>
                                <group>
                                    <field name="signature_name"/>
                                    <field name="signature_attachment_name"/>
                                    <field name="signature_hash"/>
                                </group>
                            </group>
                            <group>
                                <field name="signature_certificate_subject"/>
                                <field name="signature_certificate_issuer"/>
                            </group>
                        </page>
                        <page string="Origen">
                            <group>
                                <field name="source_model" readonly="1"/>
                                <field name="source_res_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_employee_document_history_search" model="ir.ui.view">
        <field name="name">employee.document.history.search</field>
        <field name="model">employee.document.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="document_type_id"/>
                <field name="period"/>
                <filter name="validated" string="Validados" domain="[('state', '=', 'validated')]"/>
                <filter name="uploaded" string="Cargados" domain="[('state', '=', 'uploaded')]"/>
                <filter name="worker_signed" string="Trabajador firmo" domain="[('worker_signature_state', '=', 'signed')]"/>
                <filter name="worker_signature_pending" string="Pendiente trabajador" domain="[('worker_signature_required', '=', True), ('worker_signature_state', '!=', 'signed')]"/>
                <filter name="representative_signed" string="Encargado firmo" domain="[('signature_state', '=', 'signed')]"/>
                <filter name="representative_signature_pending" string="Pendiente encargado" domain="[('signature_required', '=', True), ('signature_state', '!=', 'signed')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'document_type_id'}"/>
                    <filter name="group_period" string="Periodo" context="{'group_by': 'period'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_employee_document_file_search" model="ir.ui.view">
        <field name="name">employee.document.file.search</field>
        <field name="model">employee.document.file</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="document_type_id"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="validated" string="Validados" domain="[('state', '=', 'validated')]"/>
                <filter name="uploaded" string="Cargados" domain="[('state', 'in', ['uploaded', 'validated'])]"/>
                <filter name="worker_signed" string="Trabajador firmo" domain="[('worker_signature_state', '=', 'signed')]"/>
                <filter name="worker_signature_pending" string="Pendiente trabajador" domain="[('worker_signature_required', '=', True), ('worker_signature_state', '!=', 'signed')]"/>
                <filter name="representative_signed" string="Encargado firmo" domain="[('signature_state', '=', 'signed')]"/>
                <filter name="representative_signature_pending" string="Pendiente encargado" domain="[('signature_required', '=', True), ('signature_state', '!=', 'signed')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_employee" string="Empleado" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_category" string="Categoria" context="{'group_by': 'category'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'document_type_id'}"/>
                    <filter name="group_worker_signature_state" string="Firma trabajador" context="{'group_by': 'worker_signature_state'}"/>
                    <filter name="group_signature_state" string="Firma encargado" context="{'group_by': 'signature_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_employee_form_legajo" model="ir.ui.view">
        <field name="name">hr.employee.form.legajo</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_legajo_documents"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-folder-open">
                    <field name="legajo_document_count" widget="statinfo" string="Legajos"/>
                </button>
                <button
                    name="action_prepare_legajo_documents"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-check-square-o"
                    string="Preparar Legajos"/>
            </xpath>
        </field>
    </record>

    <record id="action_employee_document_files" model="ir.actions.act_window">
        <field name="name">Legajos General</field>
        <field name="res_model">employee.document.file</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_employee_document_file_search"/>
        <field name="context">{'search_default_group_employee': 1}</field>
    </record>

    <record id="action_employee_document_types" model="ir.actions.act_window">
        <field name="name">Tipos de Documento de Legajo</field>
        <field name="res_model">employee.document.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_employee_document_history" model="ir.actions.act_window">
        <field name="name">Historico General de Legajos</field>
        <field name="res_model">employee.document.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_employee_document_history_search"/>
        <field name="context">{'search_default_group_employee': 1}</field>
    </record>

    <record id="action_prepare_selected_document_types" model="ir.actions.server">
        <field name="name">Preparar empleados activos</field>
        <field name="model_id" ref="model_employee_document_type"/>
        <field name="binding_model_id" ref="model_employee_document_type"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_prepare_active_employee_legajos()</field>
    </record>
</odoo>
