<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_document_digital_signature_wizard_form" model="ir.ui.view">
        <field name="name">employee.document.digital.signature.wizard.form</field>
        <field name="model">employee.document.digital.signature.wizard</field>
        <field name="arch" type="xml">
            <form string="Firmar PDF con certificado">
                <group>
                    <field name="document_id"/>
                    <field name="signer_name"/>
                    <field name="use_user_certificate"/>
                </group>
                <group invisible="use_user_certificate">
                    <field name="certificate_file" filename="certificate_filename"/>
                    <field name="certificate_filename" invisible="1"/>
                    <field name="certificate_password" password="True"/>
                </group>
                <footer>
                    <button name="action_sign_document" type="object" string="Firmar PDF" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
