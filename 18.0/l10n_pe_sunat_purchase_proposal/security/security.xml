<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sunat_purchase_proposal" model="ir.module.category">
        <field name="name">Propuestas SUNAT</field>
        <field name="sequence">36</field>
    </record>

    <record id="group_sunat_purchase_proposal_user" model="res.groups">
        <field name="name">Usuario de propuestas SUNAT</field>
        <field name="category_id" ref="module_category_sunat_purchase_proposal"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="group_sunat_purchase_proposal_manager" model="res.groups">
        <field name="name">Administrador de propuestas SUNAT</field>
        <field name="category_id" ref="module_category_sunat_purchase_proposal"/>
        <field name="implied_ids" eval="[(4, ref('group_sunat_purchase_proposal_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_sunat_purchase_proposal_company" model="ir.rule">
        <field name="name">Propuestas SUNAT por empresa</field>
        <field name="model_id" ref="model_sunat_purchase_proposal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sunat_purchase_proposal_user'))]"/>
    </record>

    <record id="rule_sunat_purchase_proposal_line_company" model="ir.rule">
        <field name="name">Lineas de propuestas SUNAT por empresa</field>
        <field name="model_id" ref="model_sunat_purchase_proposal_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_sunat_purchase_proposal_user'))]"/>
    </record>
</odoo>

