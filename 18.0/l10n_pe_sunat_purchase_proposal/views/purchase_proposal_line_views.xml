<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sunat_purchase_proposal_line_list" model="ir.ui.view">
        <field name="name">sunat.purchase.proposal.line.list</field>
        <field name="model">sunat.purchase.proposal.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" multi_edit="0"
                  decoration-success="match_state in ('matched', 'generated')"
                  decoration-warning="match_state == 'difference'"
                  decoration-danger="match_state in ('missing', 'ambiguous', 'invalid')">
                <header>
                    <button name="action_open_invoice_creation_wizard" type="object" string="Generar facturas" class="oe_highlight"/>
                </header>
                <field name="proposal_id" optional="hide"/>
                <field name="source_line_number" optional="hide"/>
                <field name="match_state" widget="badge"/>
                <field name="issue_date"/>
                <field name="document_type_code"/>
                <field name="series"/>
                <field name="number"/>
                <field name="supplier_document_number"/>
                <field name="supplier_name"/>
                <field name="currency_code"/>
                <field name="taxable_base_dg" optional="hide"/>
                <field name="igv_dg" optional="hide"/>
                <field name="non_taxed_amount" optional="hide"/>
                <field name="total_amount"/>
                <field name="matched_move_id"/>
                <field name="difference_summary" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sunat_purchase_proposal_line_form" model="ir.ui.view">
        <field name="name">sunat.purchase.proposal.line.form</field>
        <field name="model">sunat.purchase.proposal.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_invoice_creation_wizard" type="object" string="Generar factura" class="oe_highlight" invisible="match_state != 'missing'"/>
                    <button name="action_open_related_move" type="object" string="Abrir factura" invisible="not matched_move_id and not generated_move_id"/>
                    <field name="match_state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="proposal_id"/>
                            <field name="car_sunat"/>
                            <field name="record_state"/>
                            <field name="validation_state"/>
                        </group>
                        <group>
                            <field name="matched_move_id"/>
                            <field name="generated_move_id"/>
                            <field name="normalized_key" groups="base.group_system"/>
                        </group>
                    </group>
                    <group string="Comprobante">
                        <field name="issue_date"/>
                        <field name="due_date"/>
                        <field name="document_type_code"/>
                        <field name="series"/>
                        <field name="purchase_year"/>
                        <field name="number"/>
                        <field name="final_number"/>
                        <field name="currency_code"/>
                        <field name="exchange_rate"/>
                    </group>
                    <group string="Proveedor">
                        <field name="supplier_document_type"/>
                        <field name="supplier_document_number"/>
                        <field name="supplier_name"/>
                    </group>
                    <group string="Importes">
                        <field name="taxable_base_dg"/>
                        <field name="igv_dg"/>
                        <field name="taxable_base_dgng"/>
                        <field name="igv_dgng"/>
                        <field name="taxable_base_dng"/>
                        <field name="igv_dng"/>
                        <field name="non_taxed_amount"/>
                        <field name="isc_amount"/>
                        <field name="icbper_amount"/>
                        <field name="other_tax_amount"/>
                        <field name="total_amount"/>
                    </group>
                    <notebook>
                        <page string="Comparacion">
                            <field name="difference_summary" nolabel="1"/>
                        </page>
                        <page string="Origen">
                            <field name="source_raw_text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sunat_purchase_proposal_line_search" model="ir.ui.view">
        <field name="name">sunat.purchase.proposal.line.search</field>
        <field name="model">sunat.purchase.proposal.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="proposal_id"/>
                <field name="supplier_document_number"/>
                <field name="supplier_name"/>
                <field name="series"/>
                <field name="number"/>
                <filter name="missing" string="No registradas" domain="[('match_state', '=', 'missing')]"/>
                <filter name="difference" string="Con diferencias" domain="[('match_state', '=', 'difference')]"/>
                <filter name="ambiguous" string="Ambiguas" domain="[('match_state', '=', 'ambiguous')]"/>
                <filter name="matched" string="Registradas" domain="[('match_state', '=', 'matched')]"/>
                <filter name="generated" string="Generadas" domain="[('match_state', '=', 'generated')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_match_state" string="Estado" context="{'group_by': 'match_state'}"/>
                    <filter name="group_proposal" string="Propuesta" context="{'group_by': 'proposal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sunat_purchase_proposal_line" model="ir.actions.act_window">
        <field name="name">Comprobantes SUNAT</field>
        <field name="res_model">sunat.purchase.proposal.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sunat_purchase_proposal_line_search"/>
    </record>
</odoo>

