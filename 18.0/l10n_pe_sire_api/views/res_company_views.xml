<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_sire_api" model="ir.ui.view">
        <field name="name">res.company.form.sire.api</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="SIRE SUNAT" groups="l10n_pe_sire_core.group_sire_manager">
                    <group>
                        <group string="Credenciales">
                            <field name="sire_ruc"/>
                            <field name="sire_sol_user"/>
                            <field name="sire_sol_password" password="True"/>
                            <field name="sire_client_id"/>
                            <field name="sire_client_secret" password="True"/>
                        </group>
                        <group string="Conexion">
                            <field name="sire_oauth_token_url"/>
                            <field name="sire_oauth_scope"/>
                            <field name="sire_api_base_url"/>
                            <field name="sire_connection_state" readonly="1"/>
                            <field name="sire_token_expiration" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <button name="action_sire_get_token" type="object" string="Probar token SUNAT" class="btn-primary"/>
                        <button name="action_sire_check_rvie_periods" type="object" string="Probar acceso RVIE" class="btn-secondary"/>
                    </group>
                    <group string="Diagnostico">
                        <field name="sire_last_connection_error" readonly="1" nolabel="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_sire_company_configuration" model="ir.actions.act_window">
        <field name="name">Configuracion SUNAT</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">form</field>
        <field name="res_id" eval="ref('base.main_company')"/>
    </record>

    <menuitem id="menu_sire_company_configuration" name="Credenciales SUNAT" parent="l10n_pe_sire_core.menu_sire_configuration" action="action_sire_company_configuration" sequence="10" groups="l10n_pe_sire_core.group_sire_manager"/>
</odoo>
