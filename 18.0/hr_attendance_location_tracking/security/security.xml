<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_tracking_device_company" model="ir.rule">
        <field name="name">Dispositivos: compañias permitidas</field>
        <field name="model_id" ref="model_hr_attendance_tracking_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_location_session_company" model="ir.rule">
        <field name="name">Jornadas GPS: compañias permitidas</field>
        <field name="model_id" ref="model_hr_attendance_location_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_location_point_company" model="ir.rule">
        <field name="name">Puntos GPS: compañias permitidas</field>
        <field name="model_id" ref="model_hr_attendance_location_point"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
