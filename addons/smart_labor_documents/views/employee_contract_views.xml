<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_form_signature" model="ir.ui.view">
        <field name="name">hr.contract.form.employee.signature</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_prepare_contract_document" type="object" string="Preparar Documento"/>
                <button name="action_apply_contract_template" type="object" string="Aplicar Plantilla" invisible="not contract_template_id"/>
                <button name="action_sync_contract_legajo_document" type="object" string="Enviar a Legajo"/>
                <button name="action_reset_contract_signature" type="object" string="Reiniciar Firma" invisible="contract_signature_state != 'signed'"/>
                <button name="%(action_report_employee_contract)d" type="action" string="Imprimir Contrato"/>
            </xpath>
            <xpath expr="//group[@name='top_info_right']" position="inside">
                <field name="contract_template_id"/>
                <field name="contract_kind"/>
                <field name="contract_signature_required"/>
                <field name="contract_signature_state" readonly="1"/>
                <field name="contract_digital_signer_user_id"/>
                <field name="contract_signed_date" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Contrato Firmado">
                    <field name="signed_contract_preview_html" widget="html" readonly="1" nolabel="1"/>
                </page>
                <page string="Firma Electronica">
                    <field name="contract_signature_preview_html" widget="html" readonly="1" nolabel="1"/>
                    <group>
                        <group>
                            <field name="contract_signature_state" readonly="1"/>
                            <field name="contract_signature_name" readonly="1"/>
                            <field name="contract_signed_date" readonly="1"/>
                            <field name="contract_signed_by_id" readonly="1"/>
                            <field name="contract_signed_partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="contract_signature_ip" readonly="1"/>
                            <field name="contract_signature_user_agent" readonly="1"/>
                            <field name="contract_signature_position_x" readonly="1"/>
                            <field name="contract_signature_position_y" readonly="1"/>
                            <field name="contract_signature_image" readonly="1" invisible="1"/>
                            <field name="contract_signature_hash" readonly="1"/>
                        </group>
                    </group>
                </page>
                <page string="Documento de Contrato">
                    <field name="contract_document_html" widget="html"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
