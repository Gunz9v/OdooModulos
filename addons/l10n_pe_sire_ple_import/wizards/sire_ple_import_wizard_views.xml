<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sire_ple_import_wizard_form" model="ir.ui.view">
        <field name="name">sire.ple.import.wizard.form</field>
        <field name="model">sire.ple.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="period_id" invisible="1" readonly="1"/>
                        <field name="filename" invisible="1"/>
                        <field name="file_data" filename="filename"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import_file" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
