<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sire_period_form_sire_ple_import" model="ir.ui.view">
        <field name="name">sire.period.form.sire.ple.import</field>
        <field name="model">sire.period</field>
        <field name="inherit_id" ref="l10n_pe_sire_core.view_sire_period_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_open_import_wizard']" position="after">
                <button name="action_open_sunat_proposal_import_wizard" type="object" string="Importar propuesta SUNAT" class="btn-secondary" groups="l10n_pe_sire_core.group_sire_analyst" invisible="registry_type != 'rvie'"/>
                <button name="action_run_sales_reconciliation" type="object" string="Conciliar RVIE" class="btn-secondary" groups="l10n_pe_sire_core.group_sire_analyst" invisible="registry_type != 'rvie'"/>
                <button name="action_open_sunat_proposal_import_wizard" type="object" string="Importar propuesta SUNAT RCE" class="btn-secondary" groups="l10n_pe_sire_core.group_sire_analyst" invisible="registry_type != 'rce'"/>
                <button name="action_run_purchase_reconciliation" type="object" string="Conciliar RCE" class="btn-secondary" groups="l10n_pe_sire_core.group_sire_analyst" invisible="registry_type != 'rce'"/>
                <button name="action_generate_structures" type="object" string="Generar Estructuras" class="btn-primary" groups="l10n_pe_sire_core.group_sire_analyst"/>
            </xpath>
            <xpath expr="//field[@name='system_only_count']/.." position="after">
                <group string="Archivos generados">
                    <field name="sire_generated_at" readonly="1"/>
                    <field name="rce_cp_txt_filename" invisible="1"/>
                    <field name="rcecom_txt_filename" invisible="1"/>
                    <field name="rceinex_txt_filename" invisible="1"/>
                    <field name="rcetca_txt_filename" invisible="1"/>
                    <field name="sire_replace_txt_filename" invisible="1"/>
                    <field name="sire_replace_zip_filename" invisible="1"/>
                    <field name="sire_complement_txt_filename" invisible="1"/>
                    <field name="sire_complement_zip_filename" invisible="1"/>
                    <field name="sire_non_domiciled_zip_filename" invisible="1"/>
                    <field name="sire_adjustment_zip_filename" invisible="1"/>
                    <field name="rce_cp_txt" string="TXT 8.1" filename="rce_cp_txt_filename" readonly="1" invisible="not rce_cp_txt"/>
                    <field name="rcecom_txt" string="TXT 8.2" filename="rcecom_txt_filename" readonly="1" invisible="not rcecom_txt"/>
                    <field name="rceinex_txt" string="TXT 8.3" filename="rceinex_txt_filename" readonly="1" invisible="not rceinex_txt"/>
                    <field name="rcetca_txt" string="TXT Tipo de cambio" filename="rcetca_txt_filename" readonly="1" invisible="not rcetca_txt"/>
                    <field name="sire_complement_txt" string="TXT Reporte Sire" filename="sire_complement_txt_filename" readonly="1" invisible="not sire_complement_txt"/>
                    <field name="sire_complement_zip" string="Zip Reporte Sire" filename="sire_complement_zip_filename" readonly="1" invisible="not sire_complement_zip"/>
                    <field name="sire_replace_txt" string="TXT Reporte Sire Reemplazo" filename="sire_replace_txt_filename" readonly="1" invisible="not sire_replace_txt"/>
                    <field name="sire_replace_zip" string="Zip Reporte Sire Reemplazo" filename="sire_replace_zip_filename" readonly="1" invisible="not sire_replace_zip"/>
                    <field name="sire_non_domiciled_zip" string="Zip No domiciliados" filename="sire_non_domiciled_zip_filename" readonly="1" invisible="not sire_non_domiciled_zip"/>
                    <field name="sire_adjustment_zip" string="Zip Ajuste posterior" filename="sire_adjustment_zip_filename" readonly="1" invisible="not sire_adjustment_zip"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Conciliacion RCE" invisible="registry_type != 'rce'">
                    <field name="purchase_reconciliation_line_ids" readonly="1">
                        <list decoration-success="status == 'matched'" decoration-warning="status == 'difference'" decoration-danger="status in ('system_only', 'sunat_only')">
                            <field name="status"/>
                            <field name="normalized_key"/>
                            <field name="taxable_base_dg_has_diff" column_invisible="1"/>
                            <field name="igv_dg_has_diff" column_invisible="1"/>
                            <field name="total_has_diff" column_invisible="1"/>
                            <field name="accounting_series"/>
                            <field name="accounting_number"/>
                            <field name="sunat_series"/>
                            <field name="sunat_number"/>
                            <field name="sunat_car_sunat"/>
                            <field name="accounting_supplier_document_number"/>
                            <field name="sunat_supplier_document_number"/>
                            <field name="accounting_taxable_base_dg"/>
                            <field name="sunat_taxable_base_dg" decoration-danger="taxable_base_dg_has_diff"/>
                            <field name="accounting_igv_dg"/>
                            <field name="sunat_igv_dg" decoration-danger="igv_dg_has_diff"/>
                            <field name="accounting_total_amount"/>
                            <field name="sunat_total_amount" decoration-danger="total_has_diff"/>
                            <field name="total_diff" decoration-danger="total_has_diff"/>
                            <field name="difference_summary" optional="hide"/>
                        </list>
                    </field>
                </page>
                <page string="Conciliacion" invisible="registry_type != 'rvie'">
                    <field name="sales_reconciliation_line_ids" readonly="1">
                        <list decoration-success="status == 'matched'" decoration-warning="status == 'difference'" decoration-danger="status in ('system_only', 'sunat_only')">
                            <field name="status"/>
                            <field name="normalized_key"/>
                            <field name="taxable_base_has_diff" column_invisible="1"/>
                            <field name="igv_has_diff" column_invisible="1"/>
                            <field name="total_has_diff" column_invisible="1"/>
                            <field name="accounting_series"/>
                            <field name="accounting_number"/>
                            <field name="sunat_series"/>
                            <field name="sunat_number"/>
                            <field name="accounting_customer_document_number"/>
                            <field name="sunat_customer_document_number"/>
                            <field name="accounting_exchange_rate"/>
                            <field name="sunat_exchange_rate"/>
                            <field name="accounting_taxable_base"/>
                            <field name="sunat_taxable_base" decoration-danger="taxable_base_has_diff"/>
                            <field name="accounting_igv_amount"/>
                            <field name="sunat_igv_amount" decoration-danger="igv_has_diff"/>
                            <field name="accounting_total_amount"/>
                            <field name="sunat_total_amount" decoration-danger="total_has_diff"/>
                            <field name="total_diff" decoration-danger="total_has_diff"/>
                            <field name="difference_summary" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
