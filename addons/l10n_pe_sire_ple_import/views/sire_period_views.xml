<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sire_period_form_sire_ple_import" model="ir.ui.view">
        <field name="name">sire.period.form.sire.ple.import</field>
        <field name="model">sire.period</field>
        <field name="inherit_id" ref="l10n_pe_sire_api.view_sire_period_form_sire_api"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_sync_sunat_proposal']" position="after">
                <button name="action_open_sunat_proposal_import_wizard" type="object" string="Importar propuesta SUNAT" class="btn-secondary" groups="l10n_pe_sire_core.group_sire_analyst" invisible="1"/>
                <button name="action_run_sales_reconciliation" type="object" string="Generar Conciliacion" class="btn-secondary" groups="l10n_pe_sire_core.group_sire_analyst" invisible="registry_type != 'rvie' or state == 'closed'"/>
                <button name="action_open_sales_reconciliation" type="object" string="Visualizar Conciliacion" class="btn-secondary" groups="l10n_pe_sire_core.group_sire_analyst" invisible="registry_type != 'rvie'"/>
                <button name="action_open_sunat_proposal_import_wizard" type="object" string="Importar propuesta SUNAT RCE" class="btn-secondary" groups="l10n_pe_sire_core.group_sire_analyst" invisible="1"/>
                <button name="action_run_purchase_reconciliation" type="object" string="Generar Conciliacion" class="btn-secondary" groups="l10n_pe_sire_core.group_sire_analyst" invisible="registry_type != 'rce' or state == 'closed'"/>
                <button name="action_open_purchase_reconciliation" type="object" string="Visualizar Conciliacion" class="btn-secondary" groups="l10n_pe_sire_core.group_sire_analyst" invisible="registry_type != 'rce'"/>
                <button name="action_generate_structures" type="object" string="Generar Estructuras" class="btn-primary" groups="l10n_pe_sire_core.group_sire_analyst" invisible="state == 'closed'"/>
            </xpath>
            <xpath expr="//field[@name='system_only_count']/.." position="after">
                <group string="Archivos generados">
                    <field name="sire_generated_at" readonly="1"/>
                    <field name="rce_cp_txt_filename" invisible="1"/>
                    <field name="rcecom_txt_filename" invisible="1"/>
                    <field name="rceinex_txt_filename" invisible="1"/>
                    <field name="rcetca_txt_filename" invisible="1"/>
                    <field name="sire_replace_txt_filename" invisible="1"/>
                    <field name="sire_replace_zip_filename" invisible="1"/>
                    <field name="sire_sunat_original_replace_txt_filename" invisible="1"/>
                    <field name="sire_sunat_original_replace_zip_filename" invisible="1"/>
                    <field name="sire_complement_txt_filename" invisible="1"/>
                    <field name="sire_complement_zip_filename" invisible="1"/>
                    <field name="sire_non_domiciled_zip_filename" invisible="1"/>
                    <field name="sire_adjustment_zip_filename" invisible="1"/>
                    <field name="sire_complement_correlative" invisible="registry_type != 'rvie' or not sire_complement_zip" readonly="state == 'closed'"/>
                    <field name="rce_cp_duplicate_count" readonly="1" invisible="not rce_cp_duplicate_count"/>
                    <field name="rce_cp_duplicate_summary" readonly="1" invisible="not rce_cp_duplicate_summary"/>
                    <field name="rce_cp_txt" string="RCE TXT 8.1 - Comprobantes nuevos (solo sistema)" filename="rce_cp_txt_filename" readonly="1" invisible="registry_type != 'rce' or not rce_cp_txt"/>
                    <button name="action_submit_rce_cp" type="object" string="Enviar 8.1" class="btn-secondary" invisible="registry_type != 'rce' or not rce_cp_txt or state == 'closed'" groups="l10n_pe_sire_core.group_sire_analyst"/>
                    <field name="rcecom_txt" string="RCE TXT 8.2 - Complemento de diferencias" filename="rcecom_txt_filename" readonly="1" invisible="registry_type != 'rce' or not rcecom_txt"/>
                    <button name="action_submit_rcecom" type="object" string="Enviar 8.2" class="btn-secondary" invisible="registry_type != 'rce' or not rcecom_txt or state == 'closed'" groups="l10n_pe_sire_core.group_sire_analyst"/>
                    <field name="rceinex_txt" string="RCE TXT 8.3 - Inclusion/exclusion (solo SUNAT)" filename="rceinex_txt_filename" readonly="1" invisible="registry_type != 'rce' or not rceinex_txt"/>
                    <button name="action_submit_rceinex" type="object" string="Enviar 8.3" class="btn-secondary" invisible="registry_type != 'rce' or not rceinex_txt or state == 'closed'" groups="l10n_pe_sire_core.group_sire_analyst"/>
                    <field name="rcetca_txt" string="RCE TXT Tipo de cambio" filename="rcetca_txt_filename" readonly="1" invisible="registry_type != 'rce' or not rcetca_txt"/>
                    <button name="action_submit_rcetca" type="object" string="Enviar tipo de cambio" class="btn-secondary" invisible="registry_type != 'rce' or not rcetca_txt or state == 'closed'" groups="l10n_pe_sire_core.group_sire_analyst"/>
                    <field name="sire_complement_txt" string="RVIE TXT Complemento" filename="sire_complement_txt_filename" readonly="1" invisible="registry_type != 'rvie' or not sire_complement_txt"/>
                    <field name="sire_complement_zip" string="RVIE Zip Complemento" filename="sire_complement_zip_filename" readonly="1" invisible="registry_type != 'rvie' or not sire_complement_zip"/>
                    <button name="action_submit_sire_complement" type="object" string="Enviar complemento RVIE" class="btn-secondary" invisible="registry_type != 'rvie' or not sire_complement_zip or state == 'closed'" groups="l10n_pe_sire_core.group_sire_analyst"/>
                    <field name="sire_replace_txt" string="TXT Reemplazo SIRE" filename="sire_replace_txt_filename" readonly="1" invisible="not sire_replace_txt"/>
                    <field name="sire_replace_zip" string="Zip Reemplazo SIRE" filename="sire_replace_zip_filename" readonly="1" invisible="not sire_replace_zip"/>
                    <button name="action_submit_sire_replace" type="object" string="Enviar reemplazo" class="btn-secondary" invisible="not sire_replace_zip or state == 'closed'" groups="l10n_pe_sire_core.group_sire_analyst"/>
                    <field name="sire_sunat_original_replace_txt" string="TXT Respaldo propuesta SUNAT original" filename="sire_sunat_original_replace_txt_filename" readonly="1" invisible="not sire_sunat_original_replace_txt"/>
                    <field name="sire_sunat_original_replace_zip" string="Zip Respaldo propuesta SUNAT original" filename="sire_sunat_original_replace_zip_filename" readonly="1" invisible="not sire_sunat_original_replace_zip"/>
                    <button name="action_submit_sire_sunat_original_replace" type="object" string="Enviar respaldo original" class="btn-secondary" invisible="not sire_sunat_original_replace_zip or state == 'closed'" groups="l10n_pe_sire_core.group_sire_analyst"/>
                    <field name="sire_non_domiciled_zip" string="RVIE Zip No domiciliados" filename="sire_non_domiciled_zip_filename" readonly="1" invisible="registry_type != 'rvie' or not sire_non_domiciled_zip"/>
                    <field name="sire_adjustment_zip" string="RVIE Zip Ajuste posterior" filename="sire_adjustment_zip_filename" readonly="1" invisible="registry_type != 'rvie' or not sire_adjustment_zip"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='import_batch_ids']/list/field[@name='valid_rows']" position="after">
                <field name="registry_type" column_invisible="1"/>
                <field name="total_taxable_base_dg" optional="show" column_invisible="parent.registry_type != 'rce'"/>
                <field name="total_igv_dg" optional="show" column_invisible="parent.registry_type != 'rce'"/>
                <field name="total_taxable_base_dgng" optional="hide" column_invisible="parent.registry_type != 'rce'"/>
                <field name="total_igv_dgng" optional="hide" column_invisible="parent.registry_type != 'rce'"/>
                <field name="total_taxable_base_dng" optional="hide" column_invisible="parent.registry_type != 'rce'"/>
                <field name="total_igv_dng" optional="hide" column_invisible="parent.registry_type != 'rce'"/>
                <field name="total_non_taxed_amount" optional="hide" column_invisible="parent.registry_type != 'rce'"/>
                <field name="total_isc_amount" optional="hide" column_invisible="parent.registry_type != 'rce'"/>
                <field name="total_icbper_amount" optional="hide" column_invisible="parent.registry_type != 'rce'"/>
                <field name="total_other_tax_amount" optional="hide" column_invisible="parent.registry_type != 'rce'"/>
                <field name="total_document_amount" optional="show"/>
                <field name="total_export_amount" optional="hide" column_invisible="parent.registry_type != 'rvie'"/>
                <field name="total_taxable_base" optional="show" column_invisible="parent.registry_type != 'rvie'"/>
                <field name="total_exempt_amount" optional="hide" column_invisible="parent.registry_type != 'rvie'"/>
                <field name="total_unaffected_amount" optional="hide" column_invisible="parent.registry_type != 'rvie'"/>
                <field name="total_igv_amount" optional="show" column_invisible="parent.registry_type != 'rvie'"/>
            </xpath>
        </field>
    </record>
</odoo>
