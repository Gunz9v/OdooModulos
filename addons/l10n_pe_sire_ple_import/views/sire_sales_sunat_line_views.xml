<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sire_sales_sunat_line_tree" model="ir.ui.view">
        <field name="name">sire.sales.sunat.line.list</field>
        <field name="model">sire.sales.sunat.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="period_id"/>
                <field name="proposal_id" column_invisible="1"/>
                <field name="source_line_number"/>
                <field name="issue_date"/>
                <field name="due_date" optional="hide"/>
                <field name="document_type"/>
                <field name="series"/>
                <field name="number"/>
                <field name="car_sunat"/>
                <field name="record_state" string="Estado comprobante" optional="hide"/>
                <field name="customer_document_type" optional="hide"/>
                <field name="customer_document_number"/>
                <field name="customer_name"/>
                <field name="currency_code"/>
                <field name="exchange_rate" optional="hide"/>
                <field name="export_amount"/>
                <field name="taxable_base"/>
                <field name="exempt_amount"/>
                <field name="unaffected_amount"/>
                <field name="igv_amount"/>
                <field name="non_taxable_amount" optional="hide"/>
                <field name="isc_amount" optional="hide"/>
                <field name="other_tax_amount" optional="hide"/>
                <field name="total_amount"/>
                <field name="original_document_date" optional="hide"/>
                <field name="original_document_type" optional="hide"/>
                <field name="original_document_series" optional="hide"/>
                <field name="original_document_number" optional="hide"/>
                <field name="normalized_key" optional="hide"/>
                <field name="source_hash" optional="hide"/>
                <field name="validation_state"/>
            </list>
        </field>
    </record>

    <record id="view_sire_sales_sunat_line_form" model="ir.ui.view">
        <field name="name">sire.sales.sunat.line.form</field>
        <field name="model">sire.sales.sunat.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="period_id"/>
                            <field name="proposal_id" invisible="1"/>
                            <field name="batch_id"/>
                            <field name="source_line_number"/>
                            <field name="validation_state"/>
                        </group>
                        <group>
                            <field name="normalized_key"/>
                            <field name="record_state" string="Estado comprobante" invisible="1"/>
                            <field name="source_hash"/>
                        </group>
                    </group>
                    <group string="Comprobante">
                        <field name="issue_date"/>
                        <field name="due_date"/>
                        <field name="document_type"/>
                        <field name="series"/>
                        <field name="number"/>
                    </group>
                    <group string="Cliente">
                        <field name="customer_document_type"/>
                        <field name="customer_document_number"/>
                        <field name="customer_name"/>
                    </group>
                    <group string="Importes">
                        <field name="currency_code"/>
                        <field name="exchange_rate"/>
                        <field name="export_amount"/>
                        <field name="taxable_base"/>
                        <field name="exempt_amount"/>
                        <field name="unaffected_amount"/>
                        <field name="igv_amount"/>
                        <field name="non_taxable_amount"/>
                        <field name="isc_amount"/>
                        <field name="other_tax_amount"/>
                        <field name="total_amount"/>
                    </group>
                    <notebook>
                        <page string="Original">
                            <field name="source_raw_text" nolabel="1"/>
                        </page>
                        <page string="Validacion">
                            <field name="validation_messages" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sire_sales_sunat_line" model="ir.actions.act_window">
        <field name="name">Lineas SUNAT RVIE</field>
        <field name="res_model">sire.sales.sunat.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sire_sales_sunat_lines" name="Lineas SUNAT" parent="l10n_pe_sire_core.menu_sire_sales" action="action_sire_sales_sunat_line" sequence="35"/>
</odoo>
