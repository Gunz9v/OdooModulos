<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_payslip_document_employee_own" model="ir.rule">
        <field name="name">Empleados pueden leer sus propias boletas publicadas</field>
        <field name="model_id" ref="model_employee_payslip_document"/>
        <field name="domain_force">
            ['&amp;', ('state', '=', 'published'), '|', ('employee_user_id', '=', user.id), ('employee_partner_id', '=', user.partner_id.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_payslip_document_hr_all" model="ir.rule">
        <field name="name">RRHH puede gestionar todas las boletas</field>
        <field name="model_id" ref="model_employee_payslip_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

