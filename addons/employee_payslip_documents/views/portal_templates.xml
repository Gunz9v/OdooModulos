<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_payslip_documents" inherit_id="portal.portal_my_home">
        <xpath expr="//div[contains(@class, 'o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Boletas de Pago</t>
                <t t-set="url" t-value="'/my/payslip-documents'"/>
                <t t-set="placeholder_count" t-value="'payslip_document_count'"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Comunicados Internos</t>
                <t t-set="url" t-value="'/my/announcements'"/>
                <t t-set="placeholder_count" t-value="'announcement_count'"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Contratos</t>
                <t t-set="url" t-value="'/my/employee-contracts'"/>
                <t t-set="placeholder_count" t-value="'employee_contract_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_payslip_documents" name="Mis Boletas de Pago">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Boletas de Pago</t>
            </t>
            <t t-if="documents">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Documento</th>
                                <th>Empleado</th>
                                <th>Periodo</th>
                                <th>Firma</th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="documents" t-as="document">
                                <td>
                                    <a t-att-href="'/my/payslip-documents/%s' % document.id">
                                        <span t-field="document.name"/>
                                    </a>
                                </td>
                                <td><span t-field="document.employee_id"/></td>
                                <td><span t-field="document.period"/></td>
                                <td>
                                    <span t-if="document.signature_state == 'signed'" class="badge text-bg-success">Firmado</span>
                                    <span t-elif="document.signature_required" class="badge text-bg-warning">Pendiente firma</span>
                                    <span t-else="" class="badge text-bg-secondary">No requerido</span>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-primary" t-att-href="'/my/payslip-documents/%s/pdf' % document.id">PDF</a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
            <t t-else="">
                <p>No hay boletas disponibles.</p>
            </t>
        </t>
    </template>

    <template id="portal_my_payslip_document_detail" name="Detalle de Boleta">
        <t t-call="portal.portal_layout">
            <style>
                .o_payslip_signature_surface {
                    position: relative;
                }
                .o_payslip_signature_frame {
                    position: absolute;
                    width: 220px;
                    min-height: 78px;
                    padding: 8px 10px;
                    border: 2px solid #198754;
                    border-radius: 6px;
                    background: rgba(255, 255, 255, 0.92);
                    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.16);
                    cursor: grab;
                    touch-action: none;
                    z-index: 5;
                }
                .o_payslip_signature_frame:active {
                    cursor: grabbing;
                }
                .o_payslip_signature_frame.o_signed {
                    cursor: default;
                    border-color: #146c43;
                }
                .o_payslip_signature_name {
                    display: block;
                    font-family: "Brush Script MT", "Segoe Script", cursive;
                    font-size: 24px;
                    line-height: 1.1;
                    color: #111827;
                }
                .o_payslip_signature_meta {
                    display: block;
                    margin-top: 4px;
                    font-size: 11px;
                    color: #495057;
                }
                .o_payslip_signature_hint {
                    display: block;
                    margin-top: 4px;
                    font-size: 11px;
                    color: #198754;
                }
                .o_payslip_signature_canvas {
                    width: 100%;
                    max-width: 420px;
                    height: 140px;
                    display: block;
                    border: 1px solid #ced4da;
                    border-radius: 6px;
                    background: #fff;
                    touch-action: none;
                }
                .o_payslip_signature_image {
                    display: block;
                    max-width: 190px;
                    max-height: 42px;
                    object-fit: contain;
                }
            </style>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">
                    <span t-field="document.name"/>
                </h3>
                <a class="btn btn-primary" t-att-href="'/my/payslip-documents/%s/pdf' % document.id">Descargar PDF</a>
            </div>
            <div class="mb-3 text-muted">
                <span t-field="document.period"/>
            </div>
            <div t-if="signature_success" class="alert alert-success" role="alert">
                <t t-out="signature_success"/>
            </div>
            <div t-if="signature_error" class="alert alert-danger" role="alert">
                <t t-out="signature_error"/>
            </div>
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                        <div>
                            <h5 class="card-title mb-1">Firma electronica</h5>
                            <p t-if="document.signature_state == 'signed'" class="mb-0 text-muted">
                                Firmado por <strong><span t-field="document.signature_name"/></strong>
                                el <span t-field="document.signed_date"/>.
                            </p>
                            <p t-elif="document.signature_required" class="mb-0 text-muted">
                                Revise la boleta y confirme su conformidad para registrar la firma.
                            </p>
                            <p t-else="" class="mb-0 text-muted">
                                Este documento no requiere firma.
                            </p>
                        </div>
                        <span t-if="document.signature_state == 'signed'" class="badge text-bg-success">Firmado</span>
                        <span t-elif="document.signature_required" class="badge text-bg-warning">Pendiente firma</span>
                        <span t-else="" class="badge text-bg-secondary">No requerido</span>
                    </div>
                    <form
                        t-if="document.signature_required and document.signature_state != 'signed'"
                        class="mt-3"
                        method="post"
                        t-att-action="'/my/payslip-documents/%s/sign' % document.id">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input id="signature_position_x" type="hidden" name="signature_position_x" t-att-value="document.signature_position_x"/>
                        <input id="signature_position_y" type="hidden" name="signature_position_y" t-att-value="document.signature_position_y"/>
                        <input id="signature_image" type="hidden" name="signature_image"/>
                        <div class="mb-3">
                            <label for="signer_name" class="form-label">Nombre completo</label>
                            <input
                                id="signer_name"
                                name="signer_name"
                                type="text"
                                class="form-control"
                                required="required"
                                t-att-value="request.env.user.name"/>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="signature_canvas">Trazo de firma</label>
                            <canvas id="signature_canvas" class="o_payslip_signature_canvas" width="840" height="280"/>
                            <button id="signature_clear" type="button" class="btn btn-sm btn-outline-secondary mt-2">Limpiar trazo</button>
                        </div>
                        <div class="form-check mb-3">
                            <input id="signature_acceptance" class="form-check-input" type="checkbox" required="required"/>
                            <label class="form-check-label" for="signature_acceptance">
                                Declaro haber revisado esta boleta y registro mi conformidad mediante firma electronica.
                            </label>
                        </div>
                        <p class="small text-muted">
                            Puede arrastrar el marco verde sobre la vista previa para ubicar la firma antes de confirmar.
                        </p>
                        <button type="submit" class="btn btn-primary">Firmar documento</button>
                    </form>
                    <div t-if="document.signature_state == 'signed'" class="mt-3 small text-muted">
                        Hash de evidencia: <code><span t-field="document.signature_hash"/></code>
                    </div>
                </div>
            </div>
            <div class="o_payslip_document_preview o_payslip_signature_surface">
                <div
                    t-if="document.signature_required"
                    id="o_payslip_signature_frame"
                    t-attf-class="o_payslip_signature_frame #{'o_signed' if document.signature_state == 'signed' else ''}"
                    t-att-data-signed="1 if document.signature_state == 'signed' else 0"
                    t-att-style="'left: ' + str(document.signature_position_x or 0.0) + '%; top: ' + str(document.signature_position_y or 0.0) + '%;'">
                    <img
                        t-if="document.signature_state == 'signed' and document.signature_image"
                        class="o_payslip_signature_image"
                        t-att-src="document.signature_image"/>
                    <span t-if="document.signature_state != 'signed' or not document.signature_image" class="o_payslip_signature_name">
                        <t t-if="document.signature_state == 'signed'" t-out="document.signature_name"/>
                        <t t-else="" t-out="request.env.user.name"/>
                    </span>
                    <span class="o_payslip_signature_meta">
                        Firma electronica
                        <t t-if="document.signature_state == 'signed'">
                            - <span t-field="document.signed_date"/>
                        </t>
                    </span>
                    <span t-if="document.signature_state != 'signed'" class="o_payslip_signature_hint">
                        Arrastre para ubicar
                    </span>
                </div>
                <div t-field="document.rendered_html"/>
            </div>
            <script>
                <![CDATA[
                (function () {
                    const frame = document.getElementById("o_payslip_signature_frame");
                    const inputX = document.getElementById("signature_position_x");
                    const inputY = document.getElementById("signature_position_y");
                    const inputImage = document.getElementById("signature_image");
                    const canvas = document.getElementById("signature_canvas");
                    const clearButton = document.getElementById("signature_clear");
                    if (!frame || !inputX || !inputY || frame.dataset.signed === "1") {
                        return;
                    }
                    const surface = frame.closest(".o_payslip_signature_surface");
                    let dragging = false;
                    let offsetX = 0;
                    let offsetY = 0;

                    function setPosition(clientX, clientY) {
                        const bounds = surface.getBoundingClientRect();
                        const maxX = Math.max(bounds.width - frame.offsetWidth, 0);
                        const maxY = Math.max(bounds.height - frame.offsetHeight, 0);
                        const x = Math.min(Math.max(clientX - bounds.left - offsetX, 0), maxX);
                        const y = Math.min(Math.max(clientY - bounds.top - offsetY, 0), maxY);
                        const percentX = bounds.width ? (x / bounds.width) * 100 : 0;
                        const percentY = bounds.height ? (y / bounds.height) * 100 : 0;
                        frame.style.left = percentX.toFixed(4) + "%";
                        frame.style.top = percentY.toFixed(4) + "%";
                        inputX.value = percentX.toFixed(4);
                        inputY.value = percentY.toFixed(4);
                    }

                    frame.addEventListener("pointerdown", function (event) {
                        dragging = true;
                        const bounds = frame.getBoundingClientRect();
                        offsetX = event.clientX - bounds.left;
                        offsetY = event.clientY - bounds.top;
                        frame.setPointerCapture(event.pointerId);
                    });
                    frame.addEventListener("pointermove", function (event) {
                        if (dragging) {
                            setPosition(event.clientX, event.clientY);
                        }
                    });
                    frame.addEventListener("pointerup", function (event) {
                        dragging = false;
                        frame.releasePointerCapture(event.pointerId);
                    });
                    frame.addEventListener("pointercancel", function () {
                        dragging = false;
                    });

                    if (!canvas || !inputImage) {
                        return;
                    }
                    const context = canvas.getContext("2d");
                    let drawing = false;
                    let hasStroke = false;
                    context.lineWidth = 4;
                    context.lineCap = "round";
                    context.lineJoin = "round";
                    context.strokeStyle = "#111827";

                    function canvasPoint(event) {
                        const bounds = canvas.getBoundingClientRect();
                        return {
                            x: ((event.clientX - bounds.left) / bounds.width) * canvas.width,
                            y: ((event.clientY - bounds.top) / bounds.height) * canvas.height,
                        };
                    }

                    function updateSignatureImage() {
                        inputImage.value = hasStroke ? canvas.toDataURL("image/png") : "";
                    }

                    canvas.addEventListener("pointerdown", function (event) {
                        drawing = true;
                        hasStroke = true;
                        canvas.setPointerCapture(event.pointerId);
                        const point = canvasPoint(event);
                        context.beginPath();
                        context.moveTo(point.x, point.y);
                        event.preventDefault();
                    });
                    canvas.addEventListener("pointermove", function (event) {
                        if (!drawing) {
                            return;
                        }
                        const point = canvasPoint(event);
                        context.lineTo(point.x, point.y);
                        context.stroke();
                        updateSignatureImage();
                        event.preventDefault();
                    });
                    canvas.addEventListener("pointerup", function (event) {
                        drawing = false;
                        updateSignatureImage();
                        canvas.releasePointerCapture(event.pointerId);
                    });
                    canvas.addEventListener("pointercancel", function () {
                        drawing = false;
                        updateSignatureImage();
                    });
                    if (clearButton) {
                        clearButton.addEventListener("click", function () {
                            context.clearRect(0, 0, canvas.width, canvas.height);
                            hasStroke = false;
                            updateSignatureImage();
                        });
                    }
                })();
                ]]>
            </script>
        </t>
    </template>

    <template id="portal_my_employee_contracts" name="Mis Contratos">
