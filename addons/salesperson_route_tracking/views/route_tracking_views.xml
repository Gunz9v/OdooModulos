<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_route_tracker" model="ir.actions.client">
        <field name="name">Mi recorrido</field>
        <field name="tag">salesperson_route_tracker</field>
    </record>

    <record id="view_route_session_list" model="ir.ui.view">
        <field name="name">salesperson.route.session.list</field>
        <field name="model">salesperson.route.session</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'running'" decoration-muted="state == 'done'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="started_at"/>
                <field name="ended_at"/>
                <field name="state" widget="badge"/>
                <field name="point_count"/>
                <field name="distance_km"/>
                <field name="last_position_at"/>
            </list>
        </field>
    </record>

    <record id="view_route_session_form" model="ir.ui.view">
        <field name="name">salesperson.route.session.form</field>
        <field name="model">salesperson.route.session</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_pause" type="object" string="Pausar" class="btn-secondary" invisible="state != 'running'"/>
                    <button name="action_resume" type="object" string="Reanudar" class="btn-primary" invisible="state != 'paused'"/>
                    <button name="action_finish" type="object" string="Finalizar" class="btn-primary" invisible="state == 'done'" confirm="¿Finalizar este recorrido?"/>
                    <button name="action_open_map" type="object" string="Ver mapa" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="running,paused,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_map" icon="fa-map-marker">
                            <field name="point_count" widget="statinfo" string="Puntos GPS"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Finalizado" bg_color="text-bg-secondary" invisible="state != 'done'"/>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="started_at" readonly="1"/>
                            <field name="ended_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="distance_km" readonly="1"/>
                            <field name="last_position_at" readonly="1"/>
                            <field name="last_latitude" readonly="1"/>
                            <field name="last_longitude" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Coordenadas" groups="salesperson_route_tracking.group_route_tracking_manager">
                            <field name="point_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="recorded_at"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="accuracy"/>
                                    <field name="speed" optional="hide"/>
                                    <field name="source"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_route_session_search" model="ir.ui.view">
        <field name="name">salesperson.route.session.search</field>
        <field name="model">salesperson.route.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="started_at"/>
                <filter name="my_routes" string="Mis recorridos" domain="[('user_id', '=', uid)]"/>
                <filter name="running" string="En curso" domain="[('state', '=', 'running')]"/>
                <filter name="today" string="Hoy" domain="[('started_at', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0))), ('started_at', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23, 59, 59)))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_user" string="Vendedor" context="{'group_by': 'user_id'}"/>
                    <filter name="group_day" string="Día" context="{'group_by': 'started_at:day'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_route_sessions" model="ir.actions.act_window">
        <field name="name">Historial de recorridos</field>
        <field name="res_model">salesperson.route.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_route_session_search"/>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <record id="action_route_team_sessions" model="ir.actions.act_window">
        <field name="name">Recorridos del equipo</field>
        <field name="res_model">salesperson.route.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_route_session_search"/>
        <field name="context">{'search_default_today': 1, 'search_default_group_user': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay recorridos para los filtros seleccionados.</p>
            <p>Consulta las rutas del equipo, revisa sus puntos GPS y abre el recorrido sobre el mapa.</p>
        </field>
    </record>
</odoo>
