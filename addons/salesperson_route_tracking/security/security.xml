<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_route_tracking" model="ir.module.category">
        <field name="name">Rastreo de rutas</field>
        <field name="description">Accesos para captura y supervisión de recorridos GPS.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_route_tracking_user" model="res.groups">
        <field name="name">Vendedor rastreado</field>
        <field name="category_id" ref="module_category_route_tracking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_route_tracking_manager" model="res.groups">
        <field name="name">Supervisor de rutas</field>
        <field name="category_id" ref="module_category_route_tracking"/>
        <field name="implied_ids" eval="[(4, ref('group_route_tracking_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_route_session_own" model="ir.rule">
        <field name="name">Vendedor: recorridos propios</field>
        <field name="model_id" ref="model_salesperson_route_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_route_tracking_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_route_session_manager" model="ir.rule">
        <field name="name">Supervisor: todos los recorridos</field>
        <field name="model_id" ref="model_salesperson_route_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_route_tracking_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_route_point_own" model="ir.rule">
        <field name="name">Vendedor: puntos propios</field>
        <field name="model_id" ref="model_salesperson_route_point"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_route_tracking_user'))]"/>
    </record>

    <record id="rule_route_point_manager" model="ir.rule">
        <field name="name">Supervisor: todos los puntos</field>
        <field name="model_id" ref="model_salesperson_route_point"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_route_tracking_manager'))]"/>
    </record>
</odoo>
