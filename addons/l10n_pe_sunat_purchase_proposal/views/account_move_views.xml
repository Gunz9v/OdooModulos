<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sunat_purchase_proposal" model="ir.ui.view">
        <field name="name">account.move.form.sunat.purchase.proposal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="sunat_purchase_proposal_line_id" readonly="1" invisible="not sunat_purchase_proposal_line_id"/>
                <field name="sunat_purchase_car" readonly="1" invisible="not sunat_purchase_proposal_line_id"/>
            </xpath>
        </field>
    </record>
</odoo>

