<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sunat_purchase_proposal_import_wizard_form" model="ir.ui.view">
        <field name="name">sunat.purchase.proposal.import.wizard.form</field>
        <field name="model">sunat.purchase.proposal.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="compare_after_import"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importar propuesta" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sunat_purchase_proposal_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar propuesta RCE</field>
        <field name="res_model">sunat.purchase.proposal.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

