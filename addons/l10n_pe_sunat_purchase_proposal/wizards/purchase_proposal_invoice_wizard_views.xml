<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sunat_purchase_proposal_invoice_wizard_form" model="ir.ui.view">
        <field name="name">sunat.purchase.proposal.invoice.wizard.form</field>
        <field name="model">sunat.purchase.proposal.invoice.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="journal_id"/>
                    <field name="product_id"/>
                    <field name="line_count" readonly="1"/>
                    <field name="line_ids" invisible="1"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Las facturas se crean en borrador con una linea resumida por el total y sin impuestos automaticos.
                    Revise las cuentas, el detalle y los impuestos antes de publicarlas.
                </div>
                <footer>
                    <button name="action_create_invoices" type="object" string="Generar borradores" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

